{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hairdresser",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "DATABASE_NAME",
      "database_id": "DATABASE_ID"
    }
  ],
  "vars": {
    "ADMIN_PASSWORD": "1234"
  }
}
